{
  "expo": {
    "name": "Pixie",
    "slug": "pixie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pixie",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.benzhou.pixie",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pixie uses your location when you ask to fill an address or run driving context in the foreground.",
        "CADisableMinimumFrameDurationOnPhone": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F7F6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F7F6"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pixie uses your location when you ask to fill an address or run driving context in the foreground. The driving sample is rounded and not retained."
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.benzhou.pixie.widgets",
          "groupIdentifier": "group.com.benzhou.pixie",
          "widgets": [
            {
              "name": "DriveContext",
              "displayName": "Pixie drive context",
              "description": "Shows the active synthetic route zone and coaching context.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "contentMarginsDisabled": false,
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": false
              },
              "android": null
            }
          ]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "benzhou",
          "project": "atlas-app",
          "note": "SENTRY_AUTH_TOKEN env var authenticates source map uploads on an EAS/native build; Expo Go never runs this plugin's native step."
        }
      ],
      "expo-sharing",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos or clips for your belongings or a road incident. Pixie asks before sharing incident files.",
          "cameraPermission": "Photograph belongings or a road scene you choose to record. Sharing incident photos requires confirmation.",
          "microphonePermission": false
        }
      ],
      "expo-video",
      "./plugins/withIOSSceneLifecycle.cjs"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.benzhou.pixie.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.benzhou.pixie"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "896de9c9-916b-4ee0-8807-144c2530573f"
      }
    },
    "owner": "benz16107"
  }
}
