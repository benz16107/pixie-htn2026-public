# Root backend configuration. Copy to .env; never commit populated credentials.
# start.sh exports this file. Manual Next.js/Expo commands need their own
# project-local environment file or exported variables (docs/RUNBOOK.md).

# Federato challenge credentials: required for schema/query refreshes.
# The API also needs the locally restored snapshot described in docs/DATA.md.
FEDERATO_CLIENT_ID=
FEDERATO_CLIENT_SECRET=

# Optional live model calls. Recorded replay needs local events, not a key.
OPENAI_API_KEY=
# ATLAS_MODEL_LEAD=gpt-6-astra
# ATLAS_MODEL_SPECIALIST=gpt-5.6-luna
# ATLAS_OFFLINE=1
# ATLAS_TRACING=off
# ATLAS_UNDERWRITER=desk

# Optional database/cache overrides. Leave unset to use repository-local paths.
# ATLAS_DB=/absolute/path/to/var/atlas.sqlite
# PIXIE_EVIDENCE_DB=/absolute/path/to/var/evidence.sqlite
# ATLAS_LAYERS_DIR=/absolute/path/to/cache/layers

# Optional Elastic provider; absent credentials use the labelled memory fallback.
ELASTIC_URL=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=

# Optional Sentry telemetry and build-time source-map uploads.
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_APP=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_WEB=atlas-web
ATLAS_ENV=hackathon
# ATLAS_SENTRY_PII=0
# ATLAS_SENTRY_MCP=1
# ATLAS_PUBLIC_URL=https://your-api-host.example  # optional uptime-monitor setup

# Next.js server settings. For manual runs, place in web/.env.local.
ATLAS_API_URL=http://localhost:8000
PIXIE_MCP_URL=http://127.0.0.1:8010/mcp
NEXT_PUBLIC_EXPO_URL=http://localhost:8081
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ATLAS_ENV=hackathon
# NEXT_PUBLIC_FIXTURES=1

# Expo client settings. For manual runs, place in app/.env.local.
# Replace localhost with the server's reachable address for a physical phone.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WEB_URL=http://localhost:3100
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ATLAS_ENV=hackathon
# Public-prefixed variables are visible in client bundles. No secrets here.
