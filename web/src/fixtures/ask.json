 "Florida property locations with unsprinklered buildings over $5M TIV": {
  "question": "Florida property locations with unsprinklered buildings over $5M TIV",
  "rationale": "Building facts hang off Location.buildings, a reference array, so the query expands and unwinds it before filtering.",
  "attempts": [
   {
    "payload": {
     "resource": "Location",
     "where": {
      "state": "FL",
      "buildings.sprinklered": false,
      "buildings.tiv": {
       "$gt": 5000000
      }
     }
    },
    "lint": [
     "buildings is a reference array: the dot-path buildings.sprinklered matches nothing. Expand it and use $elemMatch or unwind."
    ],
    "rows": 0
   },
   {
    "payload": {
     "resource": "Location",
     "where": {
      "state": "FL",
      "buildings": {
       "$elemMatch": {
        "sprinklered": false,
        "tiv": {
         "$gt": 5000000
        }
       }
      }
     }
    },
    "lint": [
     "buildings is a reference: expand it before filtering on its fields."
    ],
    "rows": 0
   },
   {
    "payload": {
     "resource": "Location",
     "where": {
      "state": "FL"
     },
     "expand": {
      "buildings": true
     },
     "unwind": "buildings",
     "filter": {
      "buildings.sprinklered": false,
      "buildings.tiv": {
       "$gt": 5000000
      }
     },
     "select": [
      "id",
      "name",
      "city",
